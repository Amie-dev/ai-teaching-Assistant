# Server Port
PORT=5000
NODE_ENV=development

# OpenAI API Key (used for embeddings: text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Groq API Key (used for Llama 3.1 inference: question classification & answering)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Chroma Vector Database URL (mapped to port 8001 in docker-compose)
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=course_materials

# Chunking & Retrieval Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
RELEVANCE_THRESHOLD=0.15

# Socratic Agent Settings
SOCRATIC_TURN_LIMIT=3
DEFAULT_ROUTE=factual
